{
  "name": "countries-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "build:screensaver": "vite build --config vite.screensaver.config.ts && node scripts/install-screensaver.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:extra": "node scripts/extract-extra-countries.mjs",
    "test:coverage": "vitest run --coverage",
    "data:regions": "node scripts/extract-regions.mjs",
    "data:facts": "node scripts/fetch-country-facts.mjs",
    "data:cities": "node scripts/extract-cities.mjs",
    "data:city-sizes": "node scripts/measure-cities.mjs",
    "data:time-zones": "node scripts/extract-time-zones.mjs",
    "data:currencies": "node scripts/fetch-currencies.mjs",
    "data:rates": "node scripts/fetch-rates.mjs",
    "data:languages": "node scripts/fetch-languages.mjs",
    "data:map": "node scripts/extract-map.mjs",
    "data:airports": "node scripts/fetch-airports.mjs",
    "data:icons": "node scripts/make-icons.mjs",
    "data:night-lights": "node scripts/make-night-lights.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "d3-geo": "^3.1.1",
    "earcut": "^3.2.4",
    "flag-icons": "^7.5.0",
    "i18n-iso-countries": "^7.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-globe.gl": "^2.38.0",
    "three": "^0.186.1",
    "three-geojson-geometry": "^2.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "all-the-cities": "^3.1.0",
    "clipper-lib": "^6.4.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "sane-topojson": "^4.0.0",
    "topojson-server": "^3.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
